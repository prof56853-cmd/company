[TEMPLATE]
# RedCore local SQLite configuration
# The default is SQLite through the bundled Node.js server.
VITE_BACKEND=sqlite

# Server settings (used by server.js)
PORT=4000
HOST=127.0.0.1

# Optional: choose where the SQLite file is stored.
# DATA_DIR=./data
# SQLITE_PATH=./data/redcore.sqlite

# Optional: force the sql.js (WASM) engine instead of the built-in
# node:sqlite engine (needed on Node < 22.5).
# REDCORE_DB_ENGINE=sqljs

# Optional: where the Vite dev server proxies /api (npm run dev).
# VITE_API_URL=http://127.0.0.1:4000

# Optional (recommended in production): secret used to sign login sessions.
# If unset, a random secret is generated once and stored in the database
# (app_settings._auth_secret). Set it explicitly on multi-instance platforms.
# REDCORE_AUTH_SECRET=change-me-to-a-long-random-value
